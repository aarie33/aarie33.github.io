---
import type { CollectionEntry } from 'astro:content';
import Base from '../Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import PrevNext from '../../components/PrevNext.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}
const { project, prev, next } = Astro.props;
const { data } = project;
---

<Base
  title={`${data.title} — Ahmad Syamsul Arifin`}
  description={data.tagline}
  image={data.cover.src}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: data.title,
    description: data.tagline,
    dateCreated: String(data.year),
    creator: { '@type': 'Person', name: 'Ahmad Syamsul Arifin' },
    keywords: data.stack.join(', '),
  }}
>
  <div class="shell project-compact">
    <Breadcrumb title={data.title} />

    <header class="project-hero">
      <div class="project-hero__meta mono">
        <span class="project-hero__id">{data.id}</span>
        <span>{data.year}</span>
        <span>{data.domain}</span>
      </div>
      <h1 class="display project-hero__title" transition:name={`project-title-${project.id}`}>{data.title}</h1>
      <p class="project-hero__tagline">{data.tagline}</p>
      <div class="project-hero__roles">
        {data.roles.map((r) => <span class="badge mono">{r}</span>)}
      </div>
    </header>

    <div class="project-compact__meta" data-reveal>
      <ProjectMeta data={data} mode="inline" />
    </div>

    <div class="prose project-compact__body" data-reveal>
      <slot />
    </div>

    <div class="project-compact__shot" data-reveal>
      <BrowserFrame src={data.cover} caption={data.tagline} sizes="100vw" showCaption={false} />
    </div>

    {data.screenshots.length > 0 && (
      <div class="project-compact__gallery">
        {data.screenshots.map((shot) => <BrowserFrame src={shot.src} caption={shot.caption} />)}
      </div>
    )}

    <PrevNext prev={prev} next={next} />
  </div>
</Base>

<style>
  .project-compact {
    max-width: 900px;
  }

  .project-hero {
    padding-top: var(--sp-8);
    padding-bottom: var(--sp-6);
  }

  .project-hero__meta {
    display: flex;
    gap: var(--sp-4);
    color: var(--text-faint);
    font-size: var(--step--1);
    margin-bottom: var(--sp-2);
  }

  .project-hero__id {
    color: var(--amber);
  }

  .project-hero__title {
    font-size: var(--step-2);
    margin-bottom: var(--sp-2);
  }

  .project-hero__tagline {
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: var(--sp-2);
  }

  .project-hero__roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .project-compact__meta {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding-block: var(--sp-4);
    margin-bottom: var(--sp-6);
  }

  .project-compact__body {
    margin-bottom: var(--sp-6);
  }

  .project-compact__shot {
    margin-bottom: var(--sp-6);
  }

  .project-compact__gallery {
    display: grid;
    gap: var(--sp-4);
  }
</style>
