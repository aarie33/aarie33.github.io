---
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/press-start-2p/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, noindex = false, jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />
  </head>
  <body>
    <div class="world-bg" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" transition:animate="fade">
      <slot />
    </main>
    <Footer />

    <script>
      function initReveal() {
        const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!items.length) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );

        items.forEach((el) => observer.observe(el));
      }

      // Pointer-driven 3D: [data-tilt] cards lean toward the cursor,
      // [data-scene] layers ([data-depth]) shift by depth for parallax.
      function initPointer3D() {
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!fine || reduceMotion) return;

        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
          const max = Number(card.dataset.tilt) || 8;
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            card.classList.add('is-tilting');
            card.style.setProperty('--ry', `${x * max * 2}deg`);
            card.style.setProperty('--rx', `${-y * max * 2}deg`);
          });
          card.addEventListener('pointerleave', () => {
            card.classList.remove('is-tilting');
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--ry', '0deg');
          });
        });

        document.querySelectorAll<HTMLElement>('[data-scene]').forEach((scene) => {
          const layers = scene.querySelectorAll<HTMLElement>('[data-depth]');
          let frame = 0;
          const onMove = (e: PointerEvent) => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(() => {
              const x = e.clientX / window.innerWidth - 0.5;
              const y = e.clientY / window.innerHeight - 0.5;
              scene.style.setProperty('--sx', `${x * 10}deg`);
              scene.style.setProperty('--sy', `${-y * 6}deg`);
              layers.forEach((el) => {
                const d = Number(el.dataset.depth);
                el.style.setProperty('--px', `${x * d * -30}px`);
                el.style.setProperty('--py', `${y * d * -20}px`);
              });
            });
          };
          window.addEventListener('pointermove', onMove, { passive: true });
          document.addEventListener('astro:before-swap', () => window.removeEventListener('pointermove', onMove), {
            once: true,
          });
        });
      }

      document.addEventListener('astro:page-load', initReveal);
      document.addEventListener('astro:page-load', initPointer3D);
    </script>
  </body>
</html>
