---
import contact from '../data/contact.json';
---

<footer class="footer">
  <div class="shell footer__inner">
    <p class="pixel footer__meta">Ahmad Syamsul Arifin · Game on</p>
    <ul class="footer__links">
      <li><a href={`mailto:${contact.email}`} class="footer__link">Email</a></li>
      <li><a href={contact.github} class="footer__link" target="_blank" rel="noreferrer">GitHub</a></li>
      <li><a href={contact.linkedin} class="footer__link" target="_blank" rel="noreferrer">LinkedIn</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 2px solid var(--rule);
    padding-block: var(--sp-8);
    background: var(--ink-sunken);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .footer__meta {
    color: var(--text-faint);
  }

  .footer__links {
    display: flex;
    gap: var(--sp-6);
  }

  .footer__link {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    transition: color var(--dur-fast);
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: var(--accent);
  }
</style>
