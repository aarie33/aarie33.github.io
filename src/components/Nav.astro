---
const links = [
  { href: '/projects/', label: 'Index' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="nav">
  <div class="shell nav__inner">
    <a href="/" class="nav__brand">
      <img src="/iso/da/database-transfer.webp" alt="" width="36" height="36" class="nav__logo" />
      <span class="pixel nav__name">Arie<span class="nav__lvl">LV.7</span></span>
    </a>
    <button
      type="button"
      class="nav__toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Toggle menu"
      data-nav-toggle
    >
      <span class="nav__bar"></span>
      <span class="nav__bar"></span>
      <span class="nav__bar"></span>
    </button>
    <nav aria-label="Primary" id="nav-menu" class="nav__menu" data-nav-menu>
      <ul class="nav__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="nav__link" aria-current={path.startsWith(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(14, 11, 38, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 2px solid var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .nav__logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
    transition: transform var(--dur-base) var(--ease-bounce);
  }

  .nav__brand:hover .nav__logo {
    transform: translateY(-4px) rotate(-8deg) scale(1.12);
  }

  .nav__name {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 0.75rem;
    color: var(--text);
  }

  .nav__lvl {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--hot);
    color: var(--on-accent);
    font-size: 0.5rem;
  }

  .nav__links {
    display: flex;
    gap: var(--sp-2);
  }

  .nav__link {
    display: inline-block;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    transition: color var(--dur-fast), background var(--dur-fast), transform var(--dur-fast) var(--ease-bounce);
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--text);
    background: var(--ink-raised);
    transform: translateY(-2px);
  }

  .nav__link[aria-current='page'] {
    color: var(--on-accent);
    background: var(--accent);
    box-shadow: 0 3px 0 #6f8a12;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 48px;
    height: 48px;
    padding: 0 12px;
    border: 2px solid var(--rule-hover);
    border-radius: var(--radius-sm);
    background: var(--ink-raised);
    box-shadow: 0 4px 0 var(--rule);
  }

  .nav__toggle:active {
    transform: translateY(4px);
    box-shadow: none;
  }

  .nav__bar {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--accent);
    transition: transform var(--dur-base) var(--ease-bounce), opacity var(--dur-fast);
  }

  .nav__toggle[aria-expanded='true'] .nav__bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__bar:nth-child(2) {
    opacity: 0;
  }

  .nav__toggle[aria-expanded='true'] .nav__bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 640px) {
    .nav__toggle {
      display: flex;
    }

    .nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: var(--sp-4) var(--gutter-mobile) var(--sp-6);
      background: rgba(14, 11, 38, 0.97);
      border-bottom: 2px solid var(--rule);
      transform-origin: top;
      transform: perspective(600px) rotateX(-90deg);
      opacity: 0;
      visibility: hidden;
      transition: transform var(--dur-base) var(--ease-bounce), opacity var(--dur-fast), visibility 0s var(--dur-base);
    }

    .nav__menu.is-open {
      transform: perspective(600px) rotateX(0);
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    .nav__links {
      flex-direction: column;
      gap: var(--sp-3);
    }

    .nav__link {
      display: block;
      padding: var(--sp-4);
      font-size: var(--step-0);
      background: var(--ink-raised);
      border: 2px solid var(--rule);
    }

    .nav__link[aria-current='page'] {
      border-color: var(--accent);
    }
  }
</style>

<script>
  function initNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-nav-menu]');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  document.addEventListener('astro:page-load', initNav);
</script>
